{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ALS printable problem set or mock exam",
  "type": "object",
  "required": ["als", "kind", "title", "sections"],
  "properties": {
    "als": { "const": "1" },
    "kind": { "const": "exam" },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "module": { "type": "string" },
    "subject": { "type": "string" },
    "theme": { "enum": ["blueprint", "folio", "clinic", "ledger"] },
    "lang": { "type": "string" },
    "sources": { "type": "array" },
    "meta": {
      "type": "object",
      "properties": {
        "course": { "type": "string" },
        "duration": { "type": "string" },
        "allowed": { "type": "string" },
        "instructions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "questions"],
        "properties": {
          "title": { "type": "string" },
          "intro": { "type": "string" },
          "questions": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/question" }
          }
        }
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": ["id", "prompt"],
      "properties": {
        "id": { "type": "string" },
        "prompt": { "type": "string" },
        "points": { "type": "number", "minimum": 0 },
        "space": { "enum": ["none", "small", "medium", "large"] },
        "solution": { "type": "string" },
        "marking": { "type": "array", "items": { "type": "string" } },
        "topic": { "type": "string" },
        "src": { "type": "string" },
        "grounded": { "type": "boolean" },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "prompt"],
            "properties": {
              "label": { "type": "string" },
              "prompt": { "type": "string" },
              "points": { "type": "number", "minimum": 0 },
              "space": { "enum": ["none", "small", "medium", "large"] },
              "solution": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
