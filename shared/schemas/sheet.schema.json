{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ALS study sheet (notes, summary or cheat sheet)",
  "type": "object",
  "required": [
    "als",
    "kind",
    "title",
    "blocks"
  ],
  "properties": {
    "als": {
      "const": "1"
    },
    "kind": {
      "const": "sheet"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "module": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "theme": {
      "enum": [
        "blueprint",
        "folio",
        "clinic",
        "ledger"
      ]
    },
    "lang": {
      "type": "string"
    },
    "sources": {
      "type": "array"
    },
    "layout": {
      "enum": [
        "notes",
        "cheatsheet"
      ]
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "section",
              "definition",
              "formula",
              "keypoints",
              "example",
              "warning",
              "table",
              "quote"
            ]
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "src": {
            "type": "string"
          },
          "grounded": {
            "type": "boolean"
          },
          "topic": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "definition"
                }
              }
            },
            "then": {
              "required": [
                "term",
                "body"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "formula"
                }
              }
            },
            "then": {
              "required": [
                "math"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "keypoints"
                }
              }
            },
            "then": {
              "required": [
                "points"
              ],
              "properties": {
                "points": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "table"
                }
              }
            },
            "then": {
              "required": [
                "headers",
                "rows"
              ],
              "properties": {
                "headers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "array"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "quote"
                }
              }
            },
            "then": {
              "required": [
                "quote"
              ]
            }
          }
        ]
      }
    },
    "dir": {
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "autoMath": {
      "type": "boolean"
    }
  }
}
