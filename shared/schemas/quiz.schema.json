{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ALS interactive trainer (quiz)",
  "type": "object",
  "required": [
    "als",
    "kind",
    "title",
    "questions"
  ],
  "properties": {
    "als": {
      "const": "1"
    },
    "kind": {
      "const": "quiz"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "module": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "theme": {
      "enum": [
        "blueprint",
        "folio",
        "clinic",
        "ledger"
      ]
    },
    "lang": {
      "type": "string"
    },
    "sources": {
      "type": "array"
    },
    "settings": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "practice",
            "test"
          ]
        },
        "shuffle": {
          "type": "boolean"
        },
        "timeLimitMin": {
          "type": "number",
          "minimum": 1
        },
        "passMark": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "prompt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "mcq",
              "multi",
              "numeric",
              "text",
              "cloze",
              "order"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "hints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "solution": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "explain": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "src": {
            "type": "string"
          },
          "grounded": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "mcq"
                }
              }
            },
            "then": {
              "required": [
                "options",
                "answer"
              ],
              "properties": {
                "options": {
                  "type": "array",
                  "minItems": 2
                },
                "answer": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "multi"
                }
              }
            },
            "then": {
              "required": [
                "options",
                "answer"
              ],
              "properties": {
                "options": {
                  "type": "array",
                  "minItems": 2
                },
                "answer": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "numeric"
                }
              }
            },
            "then": {
              "required": [
                "answer"
              ],
              "properties": {
                "answer": {
                  "type": "number"
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "text"
                }
              }
            },
            "then": {
              "required": [
                "answer"
              ],
              "properties": {
                "answer": {
                  "type": "string"
                },
                "keywords": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "cloze"
                }
              }
            },
            "then": {
              "required": [
                "text",
                "blanks"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "blanks": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "order"
                }
              }
            },
            "then": {
              "required": [
                "items"
              ],
              "properties": {
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "dir": {
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "autoMath": {
      "type": "boolean"
    }
  }
}
