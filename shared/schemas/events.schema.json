{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ALS calendar events (input to make-ics)",
  "type": "object",
  "required": ["als", "kind", "events"],
  "properties": {
    "als": { "const": "1" },
    "kind": { "const": "events" },
    "calendar": { "type": "string" },
    "timezone": { "type": "string" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "start"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "start": { "type": "string", "minLength": 10 },
          "end": { "type": "string" },
          "durationMin": { "type": "number", "minimum": 1 },
          "allDay": { "type": "boolean" },
          "description": { "type": "string" },
          "location": { "type": "string" },
          "url": { "type": "string" },
          "category": { "enum": ["deadline", "exam", "study", "review", "lecture", "other"] },
          "alarmsMin": { "type": "array", "items": { "type": "number", "minimum": 0 } },
          "module": { "type": "string" }
        }
      }
    }
  }
}
